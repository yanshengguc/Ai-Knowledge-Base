# ============================================================
# AKB 部署环境变量模板:cp .env.example .env,填真实值
# 注意:.env 含密钥,不要提交到 git(.gitignore 已排除)
# ============================================================

# 数据库 root 密码(首次启动会创建库+建表)
MYSQL_ROOT_PASSWORD=

# 后端对外端口 / 前端对外端口(默认 18082 / 18000)
BACKEND_PORT=18082
FRONTEND_PORT=18000

# JWT 签名密钥(必填,建议 32+ 随机字符)
JWT_SECRET_KEY=

# 阿里云 DashScope(Embedding 向量化)
DASHSCOPE_API_KEY=

# 阿里云 DashVector(向量库)
DASHVECTOR_API_KEY=
DASHVECTOR_ENDPOINT=

# DeepSeek(LLM 对话,OpenAI 兼容)
DEEPSEEK_API_KEY=

# 阿里云 OSS(文件存储)
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 硅基流动(重排,可选,不填则跳过重排降级为原分排序)
SILICONFLOW_API_KEY=

# SSE 超时毫秒(长回答调大)
SSE_TIMEOUT_MS=300000
