# =============================================================
# 本地敏感配置模板
# 使用方法：复制本文件为 application-local.properties，填入真实值
# application-local.properties 已被 .gitignore 忽略，切勿提交真实密钥
# =============================================================

# MySQL 数据库密码
spring.datasource.password=你的MySQL密码

# 阿里云 OSS（建议使用 RAM 子账号的 AccessKey，仅授权 OSS 权限）
aliyun.oss.access-key-id=你的AccessKeyId
aliyun.oss.access-key-secret=你的AccessKeySecret

# 百炼 DashScope API Key（Embedding 模型）
spring.ai.dashscope.api-key=你的DashScopeAPIKey

# DashVector 向量数据库
dashvector.api-key=你的DashVectorAPIKey
dashvector.endpoint=你的Cluster端点.dashvector.cn-shenzhen.aliyuncs.com
